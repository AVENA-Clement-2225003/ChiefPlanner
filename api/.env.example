APP_NAME=ChiefPlanner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=chiefplanner
DB_USERNAME=chiefplanner
DB_PASSWORD=

# Session cookie shared with the SPA (same host, ADR 0001)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Authentik (OIDC client of this environment)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/api/auth/callback"
OIDC_GROUP_USER=chiefplanner-dev-user
OIDC_GROUP_ADMIN=chiefplanner-dev-admin

# Authentik service token, scoped to the admin group only (ADR 0002)
AUTHENTIK_API_URL=
AUTHENTIK_API_TOKEN=
